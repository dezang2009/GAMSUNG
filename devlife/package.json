{
  "name": "devlife",
  "version": "0.1.0",
  "private": true,
  "description": "DEVLIFE - 1인 개발사 키우기 (텍스트 방치형 게임)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host --port 4183 --strictPort",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/game.cjs",
    "apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2"
  }
}
